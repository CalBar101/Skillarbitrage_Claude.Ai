# Copy to .env and fill in real values. Never commit .env.

# ── Meta (Facebook / Instagram / WhatsApp Cloud API) ──────────────
# developers.facebook.com → your app → Settings > Basic; Business Settings > System Users for the token
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=                 # long-lived System User token
META_GRAPH_API_VERSION=v21.0
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
META_PIXEL_ID=
META_WEBHOOK_VERIFY_TOKEN=         # any random string you choose
# WhatsApp Cloud API (optional)
META_WABA_ID=
META_WHATSAPP_PHONE_NUMBER_ID=

# ── Google (OAuth / Workspace / Ads) ──────────────────────────────
# console.cloud.google.com → APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=       # path to key file, or base64 of it
# Google Ads (optional)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=            # no dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=      # MCC id, no dashes

# ── TimePay (timepay.ai voice agents) ─────────────────────────────
TIMEPAY_API_KEY=
TIMEPAY_BASE_URL=
TIMEPAY_ORG_ID=

# ── Zoom (Server-to-Server OAuth app) ─────────────────────────────
# marketplace.zoom.us → Develop > Build App > Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── Salesa (call recordings / transcripts) ────────────────────────
SALESA_API_KEY=
SALESA_BASE_URL=

# ── Zipteams (call insights) ──────────────────────────────────────
ZIPTEAMS_API_KEY=
ZIPTEAMS_BASE_URL=

# ── LeadSquared (CRM) ─────────────────────────────────────────────
# LeadSquared → Settings > API and Webhooks
LEADSQUARED_ACCESS_KEY=
LEADSQUARED_SECRET_KEY=
LEADSQUARED_HOST=https://api-in21.leadsquared.com/v2   # use the host shown for your account region
